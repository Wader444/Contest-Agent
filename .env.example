# Twilio Credentials (Required for SMS)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+1234567890

# Recipient Phone Number (with country code)
PHONE_NUMBER=+919030240952

# Optional Agent Settings
AUTO_START=true
TZ=Asia/Kolkata
LOOK_AHEAD_DAYS=7
DAILY_ALERT_ENABLED=true
DAILY_ALERT_HOUR=8
DAILY_ALERT_MINUTE=0
SCHEDULE_SUNDAY_HOUR=10
SCHEDULE_SUNDAY_MINUTE=0
SCHEDULE_WEDNESDAY_HOUR=6
SCHEDULE_WEDNESDAY_MINUTE=0
